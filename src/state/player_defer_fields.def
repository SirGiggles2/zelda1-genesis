/* Section 5 byte representations; addresses are evidence labels ONLY.
 * X(id, role, native member offset or PHASE_ONLY, NES label, publication).
 * Coalesced D views never alias their still-immediate actor replicas.
 * No I field, native high byte, owner, padding or tick snapshot is enrolled. */
PLAYER_DEFER_FIELD(POSE_X, P, PLAYER_PHASE_ONLY, 0x0070u, POSE_PUBLICATION)
PLAYER_DEFER_FIELD(POSE_Y, P, PLAYER_PHASE_ONLY, 0x0084u, POSE_PUBLICATION)
PLAYER_DEFER_FIELD(GRID, D, PLAYER_PHASE_ONLY, 0x0394u, MOVEMENT_PUBLICATION)
PLAYER_DEFER_FIELD(POS_FRAC, D, PLAYER_PHASE_ONLY, 0x03A8u, MOVEMENT_PUBLICATION)
PLAYER_DEFER_FIELD(INPUT_DIR, D, PLAYER_PHASE_ONLY, 0x03F8u, ACTOR_BRIDGE)
PLAYER_DEFER_FIELD(MOVING_DIR, D, PLAYER_PHASE_ONLY, 0x000Fu, ACTOR_BRIDGE)
PLAYER_DEFER_FIELD(STATE, D, PLAYER_PHASE_ONLY, 0x00ACu, ACTOR_BRIDGE)
PLAYER_DEFER_FIELD(QSPEED_FRAC, D, PLAYER_PHASE_ONLY, 0x03BCu, ACTOR_BRIDGE)
PLAYER_DEFER_FIELD(ANIM_COUNTER, D, PLAYER_PHASE_ONLY, 0x03D0u, ACTOR_BRIDGE)
PLAYER_DEFER_FIELD(ANIM_FRAME, D, PLAYER_PHASE_ONLY, 0x03E4u, ANIMATION_PUBLICATION)
PLAYER_DEFER_FIELD(INVINCIBILITY, D, PLAYER_PHASE_ONLY, 0x04F0u, ACTOR_BRIDGE)
PLAYER_DEFER_FIELD(SHOVE_DIR, D, PLAYER_PHASE_ONLY, 0x00C0u, ACTOR_BRIDGE)
PLAYER_DEFER_FIELD(SHOVE_DISTANCE, D, PLAYER_PHASE_ONLY, 0x00D3u, ACTOR_BRIDGE)
PLAYER_DEFER_FIELD(DIAGONAL, D, PLAYER_PHASE_ONLY, 0x0056u, ACTOR_BRIDGE)
PLAYER_DEFER_FIELD(OBJ_DIR, D, __builtin_offsetof(PlayerRam, obj_dir), 0x0098u, IMAGE_SEMANTIC)
PLAYER_DEFER_FIELD(SHOT_COLLISION, D, __builtin_offsetof(PlayerRam, shot_collision_flag), 0x000Eu, IMAGE_SEMANTIC)
PLAYER_DEFER_FIELD(LADDER, D, __builtin_offsetof(PlayerRam, ladder_slot), 0x0064u, IMAGE_SEMANTIC)
PLAYER_DEFER_FIELD(COLLIDED_TILE, D, __builtin_offsetof(PlayerRam, collided_tile), 0x049Eu, IMAGE_SEMANTIC)
PLAYER_DEFER_FIELD(DOORWAY_NES, D, __builtin_offsetof(PlayerRam, doorway_nes), 0x0053u, IMAGE_SEMANTIC)
PLAYER_DEFER_FIELD(PARALYZED, D, __builtin_offsetof(PlayerRam, paralyzed), 0x0512u, IMAGE_SEMANTIC)
PLAYER_DEFER_FIELD(SWORD_BLOCKED, D, __builtin_offsetof(PlayerRam, sword_blocked), 0x052Eu, IMAGE_SEMANTIC)
PLAYER_DEFER_FIELD(BUBBLE_TIMER, D, __builtin_offsetof(PlayerRam, bubble_block_timer), 0x004Cu, IMAGE_SEMANTIC)
PLAYER_DEFER_FIELD(SWORD_QSPEED, D, __builtin_offsetof(PlayerRam, sword_qspeed), (0x03BCu + 13u), IMAGE_SEMANTIC)
PLAYER_DEFER_FIELD(ARROW_X, D, __builtin_offsetof(PlayerRam, arrow_rod.x), (0x0070u + 18u), ARROW_SLICE)
PLAYER_DEFER_FIELD(ARROW_Y, D, __builtin_offsetof(PlayerRam, arrow_rod.y), (0x0084u + 18u), ARROW_SLICE)
PLAYER_DEFER_FIELD(ARROW_DIR, D, __builtin_offsetof(PlayerRam, arrow_rod.dir), (0x0098u + 18u), ARROW_SLICE)
PLAYER_DEFER_FIELD(ARROW_STATE, D, __builtin_offsetof(PlayerRam, arrow_rod.state), (0x00ACu + 18u), ARROW_SLICE)
PLAYER_DEFER_FIELD(ARROW_ANIM_COUNTER, D, __builtin_offsetof(PlayerRam, arrow_rod.anim_counter), (0x03D0u + 18u), ARROW_SLICE)
PLAYER_DEFER_FIELD(ARROW_QSPEED, D, __builtin_offsetof(PlayerRam, arrow_rod.qspeed), (0x03BCu + 18u), ARROW_SLICE)
PLAYER_DEFER_FIELD(ARROW_GRID, D, __builtin_offsetof(PlayerRam, arrow_rod.grid), (0x0394u + 18u), ARROW_SLICE)
PLAYER_DEFER_FIELD(ARROW_POS_FRAC, D, __builtin_offsetof(PlayerRam, arrow_rod.pos_frac), (0x03A8u + 18u), ARROW_SLICE)
PLAYER_DEFER_FIELD(SWORD_X, P, PLAYER_PHASE_ONLY, (0x0070u + 13u), WEAPON_PUBLICATION)
PLAYER_DEFER_FIELD(SWORD_Y, P, PLAYER_PHASE_ONLY, (0x0084u + 13u), WEAPON_PUBLICATION)
PLAYER_DEFER_FIELD(SWORD_DIR, P, PLAYER_PHASE_ONLY, (0x0098u + 13u), WEAPON_PUBLICATION)
PLAYER_DEFER_FIELD(SWORD_STATE, P, PLAYER_PHASE_ONLY, (0x00ACu + 13u), WEAPON_PUBLICATION)
