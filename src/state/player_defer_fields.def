PLAYER_DEFER_FIELD(BEAM_Y, P, PLAYER_PHASE_ONLY, (0x0084u + 14u), WEAPON_PUBLICATION)
PLAYER_DEFER_FIELD(BEAM_DIR, P, PLAYER_PHASE_ONLY, (0x0098u + 14u), WEAPON_PUBLICATION)
PLAYER_DEFER_FIELD(BEAM_STATE, P, PLAYER_PHASE_ONLY, (0x00ACu + 14u), WEAPON_PUBLICATION)
PLAYER_DEFER_FIELD(BEAM_ANIM_COUNTER, P, PLAYER_PHASE_ONLY, (0x03D0u + 14u), WEAPON_PUBLICATION)
PLAYER_DEFER_FIELD(BEAM_QSPEED, P, PLAYER_PHASE_ONLY, (0x03BCu + 14u), WEAPON_PUBLICATION)
PLAYER_DEFER_FIELD(BEAM_GRID, P, PLAYER_PHASE_ONLY, (0x0394u + 14u), WEAPON_PUBLICATION)
